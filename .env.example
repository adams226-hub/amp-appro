# Pour Docker : chemin dans le volume persistant.
AMP_DB=/data/amp-appro.sqlite3
AMP_HOST=127.0.0.1
AMP_PORT=8080
# Origines CORS autorisees (virgules). L'APK utilise https://app.amp.local.
# Pour tester depuis un navigateur local : https://app.amp.local,http://127.0.0.1:5500
AMP_CORS_ORIGINS=https://app.amp.local
# Compose impose AMP_HOST=0.0.0.0 et AMP_PORT=8080 dans le conteneur.
# Hors Docker, remplacer AMP_DB par un chemin existant accessible en ecriture.
